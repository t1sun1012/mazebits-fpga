* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.v text eol=lf
*.sv text eol=lf
*.xdc text eol=lf
*.mem text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.npz binary

# Preserve generator formatting in scientific figures.
results/**/*.svg text eol=lf -whitespace
# Recorded training-source bytes include terminal blank lines in tests.
python/tests/*.py whitespace=-blank-at-eof
