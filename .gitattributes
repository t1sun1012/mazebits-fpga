* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.v text eol=lf
*.sv text eol=lf
*.xdc text eol=lf
*.mem text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.npz binary

# Preserve generator formatting in scientific figures.
results/**/*.svg text eol=lf -whitespace
# Preserve recorded experiment source bytes, including terminal blank lines.
python/**/*.py whitespace=-blank-at-eof
*.vh text eol=lf
*.tcl text eol=lf
constraints/reference/Nexys-4-DDR-Master.xdc -text -whitespace
*.rpt text eol=lf -whitespace
.gitattributes text eol=lf
.gitignore text eol=lf
